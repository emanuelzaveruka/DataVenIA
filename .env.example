# Provider de LLM usado por lib/llm/get-llm-provider.ts (§15 de contexto-geral.md).
# Configure pelo menos uma das chaves abaixo. Se ambas estiverem presentes, use LLM_PROVIDER
# para forçar a escolha; sem ela, ANTHROPIC_API_KEY tem prioridade sobre OPENAI_API_KEY.

# LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
